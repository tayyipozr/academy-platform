# Public domains
APP_DOMAIN=academy.example.com
STORAGE_DOMAIN=storage.example.com
LETSENCRYPT_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_DB=academy_platform
POSTGRES_USER=academy_user
POSTGRES_PASSWORD=replace-with-strong-database-password

DB_HOST=postgres
DB_PORT=5432
DB_NAME=academy_platform
DB_USER=academy_user
DB_PASSWORD=replace-with-strong-database-password

DB_POOL_MIN_IDLE=5
DB_POOL_MAX_SIZE=20

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=replace-with-strong-redis-password

# MinIO
MINIO_ROOT_USER=academy_storage_admin
MINIO_ROOT_PASSWORD=replace-with-strong-storage-password

MEDIA_BUCKET=academy-media
MEDIA_REGION=us-east-1

MEDIA_INTERNAL_ENDPOINT=http://minio:9000
MEDIA_PUBLIC_ENDPOINT=http://storage.example.com

MEDIA_ACCESS_KEY=academy_storage_admin
MEDIA_SECRET_KEY=replace-with-strong-storage-password

# Session
SESSION_TIMEOUT=30m

# Reports
REPORT_RETENTION=30d
REPORT_DOWNLOAD_URL_DURATION=5m
REPORT_EXECUTOR_CORE_POOL_SIZE=2
REPORT_EXECUTOR_MAX_POOL_SIZE=4
REPORT_EXECUTOR_QUEUE_CAPACITY=100

# Java
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC
