upstream academy_frontend {
    server frontend:3000;
    keepalive 32;
}

upstream academy_backend {
    server backend:8080;
    keepalive 32;
}

upstream academy_storage {
    server minio:9000;
    keepalive 16;
}


server {
    listen 80;
    server_name ${APP_DOMAIN};

    client_max_body_size 25m;

    location /backend/actuator/ {
        return 404;
    }

    location /backend/ {
        proxy_pass http://academy_backend/;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_set_header X-Forwarded-For
            $proxy_add_x_forwarded_for;

        proxy_set_header X-Forwarded-Proto
            $scheme;

        proxy_set_header X-Forwarded-Host
            $host;

        proxy_set_header X-Forwarded-Port
            $server_port;

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location /_next/static/ {
        proxy_pass http://academy_frontend;

        proxy_http_version 1.1;

        proxy_set_header Host $host;

        proxy_cache_valid 200 365d;

        add_header Cache-Control
            "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://academy_frontend;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_set_header X-Forwarded-For
            $proxy_add_x_forwarded_for;

        proxy_set_header X-Forwarded-Proto
            $scheme;

        proxy_set_header X-Forwarded-Host
            $host;

        proxy_set_header X-Forwarded-Port
            $server_port;
    }
}


server {
    listen 80;
    server_name ${STORAGE_DOMAIN};

    client_max_body_size 600m;

    proxy_request_buffering off;
    proxy_buffering off;

    location / {
        proxy_pass http://academy_storage;

        proxy_http_version 1.1;

        proxy_set_header Host $http_host;

        proxy_set_header X-Real-IP
            $remote_addr;

        proxy_set_header X-Forwarded-For
            $proxy_add_x_forwarded_for;

        proxy_set_header X-Forwarded-Proto
            $scheme;

        proxy_connect_timeout 30s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
