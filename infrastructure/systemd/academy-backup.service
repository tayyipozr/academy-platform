[Unit]
Description=Academy Platform Backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=academy
Group=academy
WorkingDirectory=/opt/academy-platform

Environment=ENV_FILE=.env.production

ExecStart=/opt/academy-platform/infrastructure/scripts/backup-all.sh

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

NoNewPrivileges=true
PrivateTmp=true
