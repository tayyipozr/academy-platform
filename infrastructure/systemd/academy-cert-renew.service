[Unit]
Description=Renew Academy Platform TLS certificates
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=academy
Group=academy
WorkingDirectory=/opt/academy-platform

Environment=ENV_FILE=.env.production

ExecStart=/opt/academy-platform/infrastructure/scripts/renew-certificates.sh

NoNewPrivileges=true
PrivateTmp=true
